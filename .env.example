# Copy to `.env` (git-ignored). Compose reads `.env` automatically.

# Required existing host GitHub CLI config directory, mounted read-only in the
# development container.
GH_CONFIG_SOURCE_PATH=${HOME}/.config/gh

# Required writable provider runtime shared by the Codex, Kimi, and OpenCode
# homes. Keep it outside DEV_HOME_PATH.
AI_PROVIDER_RUNTIME_SOURCE_PATH=/opt/hermes-dind-shared/auth/provider-runtime

# Required exact immutable agent-context bundle. Replace the bundle ID; never
# use the mutable `current` discovery link or a broad shared parent.
AGENT_CONTEXT_SOURCE_PATH=/opt/hermes-dind-shared/agent-context/bundles/REPLACE_WITH_BUNDLE_ID

# Optional dedicated development-home path.
# DEV_HOME_PATH=/home/dev
